# Diary.zip 서버 환경변수 예시. 실제 값은 .env 또는 Render Environment에만 넣고 Git에 커밋하지 마세요.
PORT=5000
DATABASE_URL=postgresql://username:password@host:5432/database

# OpenAI (GPT)
OPENAI_API_KEY=sk-your-openai-api-key
# 선택: 사용할 모델. 비우면 gpt-4o-mini -> gpt-4.1-mini 순서로 시도합니다.
OPENAI_MODEL=gpt-4o-mini
# 선택: 요청 제한 시간(ms). 기본 25000
OPENAI_TIMEOUT_MS=25000

# 보안 키 (아래 명령으로 서로 다른 값 2개 생성)
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your_long_random_encryption_key
JWT_SECRET=your_long_random_jwt_secret

# 선택: 공유 DB 커넥션 풀 크기 (기본 5)
DB_POOL_MAX=5
